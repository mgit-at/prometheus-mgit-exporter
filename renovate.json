{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "security:gomodIndirectSecurityUpdates"
    ],
    "osvVulnerabilityAlerts": true,
    "timezone": "Europe/Vienna",
    "schedule": ["* 0-6 * * *"],
    "ignorePaths": [
        ".gitlab-ci.yml"
    ],
    "postUpdateOptions": ["gomodTidy"],
    "prHourlyLimit": 2,
    "prConcurrentLimit": 2,
    "major": {
        "dependencyDashboardApproval": true
    },
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "autoApprove": true
    },
    "packageRules": [
        {
            "description": "wait until Go modules are three days old",
            "matchDatasources": ["go"],
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "go/toolchain directives are pinned together with go_sdk in MODULE.bazel - update manually",
            "matchManagers": ["gomod"],
            "matchDepTypes": ["golang", "toolchain"],
            "enabled": false
        },
        {
            "description": "update indirect dependencies",
            "matchManagers": ["gomod"],
            "matchDepTypes": ["indirect"],
            "matchCurrentVersion": "!/^v?0\\./",
            "matchUpdateTypes": ["minor", "patch"],
            "enabled": true
        },
        {
            "description": "auto merge minor and patch releases of stable (>=1.0) packages",
            "matchUpdateTypes": ["minor", "patch"],
            "matchCurrentVersion": "!/^v?0\\./",
            "automerge": true,
            "autoApprove": true
        },
        {
            "description": "group stable Go minor and patch updates into one auto-merged MR",
            "matchManagers": ["gomod"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "go non-major",
            "automerge": true,
            "autoApprove": true
        },
        {
            "description": "Go 0.x patch updates rarely break: group them into one MR that needs review",
            "matchManagers": ["gomod"],
            "matchUpdateTypes": ["patch"],
            "matchCurrentVersion": "/^v?0\\./",
            "groupName": "go non-major (0.x)",
            "groupSlug": "go-non-major-0.x",
            "automerge": false,
            "autoApprove": false
        },
        {
            "description": "Go 0.x minor updates may contain breaking changes: one MR per module, needs review",
            "matchManagers": ["gomod"],
            "matchUpdateTypes": ["minor"],
            "matchCurrentVersion": "/^v?0\\./",
            "groupName": null,
            "automerge": false,
            "autoApprove": false
        },
        {
            "description": "untagged commits (pseudo-versions) always need review; no minimumReleaseAge because Renovate requires a release timestamp by default",
            "matchManagers": ["gomod"],
            "matchUpdateTypes": ["digest"],
            "groupName": "go non-major (0.x)",
            "groupSlug": "go-non-major-0.x",
            "minimumReleaseAge": null,
            "automerge": false,
            "autoApprove": false
        },
        {
            "description": "stable Go modules despite 0.x versions, including indirect ones: group and auto merge them with the other Go releases",
            "matchManagers": ["gomod"],
            "matchPackageNames": [
                "golang.org/x/tools",
                "golang.org/x/crypto",
                "golang.org/x/oauth2",
                "golang.org/x/sync",
                "golang.org/x/sys",
                "golang.org/x/text",
                "golang.org/x/image",
                "golang.org/x/mod",
                "golang.org/x/net",
                "golang.org/x/time"
            ],
            "matchUpdateTypes": ["minor", "patch"],
            "enabled": true,
            "groupName": "go non-major",
            "automerge": true,
            "autoApprove": true
        },
        {
            "description": "update bazel modules",
            "matchManagers": ["bazel-module"],
            "matchUpdateTypes": ["minor", "patch"],
            "groupName": "bazel non-major",
            "automerge": true,
            "autoApprove": true
        }
    ]
}
